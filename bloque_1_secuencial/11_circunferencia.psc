Algoritmo Circunferencia
    // Ejercicio: Calcular la longitud y el area de una circuferencia

    // Variables y datos del problema
   Definir R,L,A como real
    // Entrada de datos y validaciones
  Escribir "Ingresar el radio:"
   Leer R
    // Proceso y cálculos
 L <- 2*3.14159265*R
 A <- 3.14159265*(R)^2
  Escribir "La longitud es:" , L
  Escribir "El area del circulo es:" , A
FinAlgoritmo
